# Database
DATABASE_URL=""
# ... if you use Supabase
DIRECT_URL=""
# Optional: connection pool limits (defaults: max 8, idleTimeoutMillis 10000)
# DB_POOL_MAX=8
# DB_POOL_IDLE_TIMEOUT_MS=10000

# Site url
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Env stripe (dev/stg only). deploy.sh appends +<git-hash>. Omit in .env.prd for no stripe.
NEXT_PUBLIC_VERSION=local

# Authentication
BETTER_AUTH_SECRET=""
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
# Mind Share: also gates Drive ingestion (F4/P1a) — without a real value, "Connect" in Settings > Integrations has nothing to authorize. See product specification "Unblocking the remaining work" for the exact Cloud Console steps.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Plunk
PLUNK_API_KEY=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
NEXT_PUBLIC_PRICE_ID_PRO_MONTHLY="asdf"
NEXT_PUBLIC_PRICE_ID_PRO_YEARLY="asdf"
NEXT_PUBLIC_PRICE_ID_LIFETIME="asdf"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# ... for PostHog - reused from monitoring section

# Monitoring
# ... for PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# ... for Sentry
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""

# AI
# Mind Share: required to unblock the context classifier (P1c), Context Agent (P2a),
# inference-risk firewall check (P2b), and negotiateContext's answer generation — all currently blocked
# without a real key. All Mind Share agents and the web app's chat route go through OpenRouter
# (packages/ai/lib/provider.ts) so one key picks the model for all of them. See product specification "Unblocking the remaining work".
OPENROUTER_API_KEY=""
# Unused by Mind Share (kept for the starter template's own AI examples, if any use them directly).
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Mastra
VECTOR_DATABASE_URL=""
# Optional: vector store pool limits (defaults: max 5, idleTimeoutMillis 10000)
# VECTOR_POOL_MAX=5
# VECTOR_POOL_IDLE_TIMEOUT_MS=10000

# Jobs (pg-boss). Optional: max connections (default 10), pool timeouts (avoid "connection terminated" in Cloud Run)
# PGBOSS_MAX=10
# PGBOSS_IDLE_TIMEOUT_MS=120000
# PGBOSS_CONNECTION_TIMEOUT_MS=10000
